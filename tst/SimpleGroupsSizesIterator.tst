#############################################################################
##
#W  SimpleGroupsSizesIterator.tst                                 Stefan Kohl
##
##  This file contains automated tests of iterators of orders of
##  finite simple groups.
##
#############################################################################

gap> START_TEST( "SimpleGroupsSizesIterator.tst" );
gap> iter := SimpleGroupsSizesIterator();
<iterator of orders of simple groups>
gap> NextIterator(iter);
60
gap> iter := SimpleGroupsSizesIterator(1);
<iterator of orders of simple groups>
gap> NextIterator(iter);
60
gap> iter := SimpleGroupsSizesIterator(1:names);
<iterator of orders of simple groups>
gap> NextIterator(iter);
[ 60, "Alt", [ 5 ], "A5" ]
gap> iter := SimpleGroupsSizesIterator(1:names,nopsl2);
